{
  "name": "vogue-merry",
  "version": "0.1.0",
  "private": true,
  "description": "Vogue Merry — mémoire projet, journaux de bord, recherche, traces audio, escales, caps validés et Log Pose.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "backend": "node backend/server.js",
    "transcription": "concurrently -k -n moteur,voix \"VOGUE_WHISPER_MODEL=large-v3-turbo node backend/transcription-server-v6.js\" \"node backend/speaker-sync-server.js\"",
    "transcription:setup": "bash scripts/setup-local-transcription.sh",
    "dev:all": "concurrently \"npm run backend\" \"npm run transcription\" \"npm run dev\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "multer": "2.4.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "type": "module"
}
