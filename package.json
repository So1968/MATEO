{
  "name": "vogue-merry",
  "version": "0.1.0",
  "private": true,
  "description": "Vogue Merry — mémoire projet, journaux de bord, recherche, traces audio, escales, caps validés et Log Pose.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "backend": "node backend/server.js",
    "transcription": "VOGUE_WHISPER_MODEL=large-v3-turbo node backend/transcription-server-v6.js",
    "transcription:setup": "bash scripts/setup-local-transcription.sh",
    "dev:all": "concurrently \"npm run backend\" \"npm run transcription\" \"npm run dev\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "lucide-react": "1.14.0",
    "multer": "2.4.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "8.0.10"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  },
  "type": "module"
}
